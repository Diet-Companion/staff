{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Diet-Companion/staff/evals/schemas/architect-task.schema.json",
  "title": "Architect eval bundle (S-ARCH-049)",
  "description": "One golden, hidden or promotion design bundle for the Architect. The seeding agent writes it (S-GEN-067); the eval runner reads it. base_sha, overlay, ticket and comments are what the agent sees. spec, summary and seeding are never shown to it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "agent",
    "set",
    "kind",
    "base_sha",
    "ticket",
    "overlay",
    "comments",
    "spec"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]{12}$",
      "description": "Opaque; carries no hint of kind or content."
    },
    "agent": {
      "const": "architect"
    },
    "set": {
      "enum": [
        "visible",
        "hidden",
        "promotion"
      ]
    },
    "kind": {
      "enum": [
        "seeded",
        "clean"
      ]
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The pinned product commit (S-GEN-043)."
    },
    "seeding": {
      "$ref": "#/$defs/seeding"
    },
    "summary": {
      "type": "string",
      "maxLength": 600,
      "description": "The seeding agent's note on what the bundle tests. Private."
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "title",
        "body"
      ],
      "properties": {
        "label": {
          "enum": [
            "arch:design"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "overlay": {
      "$ref": "#/$defs/files",
      "description": "Written onto the product before the agent runs, under requirements/, architecture/ and knowledge/rules/ only: new ready requirements (1 to 3 of them quality requirements with crisp targets) and, optionally, accepted ADRs, components, quality scenarios and interfaces with their specs."
    },
    "comments": {
      "type": "array",
      "maxItems": 0,
      "description": "Operator comments on the ticket, oldest first, as the agent sees them. None in v1 bundles.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    },
    "spec": {
      "$ref": "#/$defs/spec"
    },
    "spec_counts": {
      "$ref": "#/$defs/spec_counts"
    }
  },
  "$defs": {
    "files": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9._/-]{1,200}$"
          },
          "content": {
            "type": "string",
            "maxLength": 200000
          }
        }
      }
    },
    "seeding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "maxLength": 40
        },
        "staff_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "holdout_seed": {
          "type": "boolean",
          "description": "Seeded bundles of a promotion set use holdout seeds only (S-GEN-038)."
        }
      }
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Where the plant sits: a path, or a path and an ID (S-GEN-067)."
    },
    "violates": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The rule or ID the plant violates (S-GEN-067)."
    },
    "corrected_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "description": "The text as it reads without the plant (S-GEN-067). Never in the overlay or the ticket."
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "description": "The bundle's machine-checkable spec (S-GEN-067, S-ARCH-049). Never shown to the agent. Agent-assigned ADR and IF IDs never appear in keys; the bundle supplies the REQ IDs.",
      "required": [
        "clean",
        "quality_drivers",
        "conflicts",
        "defects",
        "interface_needs",
        "unknown_figures"
      ],
      "properties": {
        "clean": {
          "type": "boolean",
          "description": "true on a clean bundle: a declaration that no defect was seeded (S-GEN-067)."
        },
        "quality_drivers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/quality_driver"
          }
        },
        "conflicts": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/conflict"
          }
        },
        "defects": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/defect"
          }
        },
        "interface_needs": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/interface_need"
          }
        },
        "unknown_figures": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/unknown_figure"
          }
        },
        "editable_versions": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "description": "Draft interface versions on base + overlay the agent may revise in place. A spec version revising one keeps the bundle's version number, so it is left out of the unnecessary-breaking rate.",
          "items": {
            "type": "string",
            "pattern": "^IF-[0-9]{3,}@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    "quality_driver": {
      "type": "object",
      "additionalProperties": false,
      "description": "A ready quality requirement in the overlay with no accepted QAS. Key: (REQ ID, attribute, target).",
      "required": [
        "req",
        "attribute",
        "target"
      ],
      "properties": {
        "req": {
          "type": "string",
          "pattern": "^REQ-[0-9]{3,}$"
        },
        "attribute": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "aliases": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": "Other names for the attribute (a diagnostic only)."
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "direction"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "direction": {
              "enum": [
                "max",
                "min"
              ],
              "description": "max: the measure is at most the value; min: at least."
            }
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "description": "A planted clash with a live constraint of an accepted ADR. Key: the constraint ID.",
      "required": [
        "constraint_id",
        "location",
        "violates",
        "corrected_text"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "pattern": "^ADR-[0-9]{3,}/C-[0-9]{3,}$"
        },
        "also": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "description": "Other constraint IDs a careful reader could fairly name for the same clash.",
          "items": {
            "type": "string",
            "pattern": "^ADR-[0-9]{3,}/C-[0-9]{3,}$"
          }
        },
        "also_defect_targets": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "description": "REQs or ACs of the clash: a contradicts defect item on one of them is excused (neither a match nor a false positive).",
          "items": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}(/AC-[0-9]{3,})?$"
          }
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "violates": {
          "$ref": "#/$defs/violates"
        },
        "corrected_text": {
          "$ref": "#/$defs/corrected_text"
        }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "description": "A planted requirement defect, in the Developer trap's shape. Key: (REQ or AC ID, defect kind).",
      "required": [
        "target",
        "kinds",
        "location",
        "violates",
        "corrected_text"
      ],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^REQ-[0-9]{3,}(/AC-[0-9]{3,})?$"
        },
        "also": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "description": "Other targets a careful reader could fairly name for the same planted problem.",
          "items": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}(/AC-[0-9]{3,})?$"
          }
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "untestable",
              "contradicts",
              "infeasible"
            ]
          }
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "violates": {
          "$ref": "#/$defs/violates"
        },
        "corrected_text": {
          "$ref": "#/$defs/corrected_text"
        }
      }
    },
    "interface_need": {
      "type": "object",
      "additionalProperties": false,
      "description": "An interface element an AC needs. Key: (the AC's key.target_id, expected compatibility class). An interface with no breaking need has a compatible design.",
      "required": [
        "ac",
        "target_id",
        "if_id",
        "element",
        "expected_class"
      ],
      "properties": {
        "ac": {
          "type": "string",
          "pattern": "^REQ-[0-9]{3,}/AC-[0-9]{3,}$"
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "if_id": {
          "type": "string",
          "pattern": "^IF-[0-9]{3,}$"
        },
        "element": {
          "enum": [
            "operation",
            "event"
          ]
        },
        "expected_class": {
          "enum": [
            "compatible",
            "breaking"
          ]
        }
      }
    },
    "unknown_figure": {
      "type": "object",
      "additionalProperties": false,
      "description": "A figure the design needs and no source states. Key: (entity, attribute).",
      "required": [
        "entity",
        "attribute",
        "terms",
        "units",
        "needed_by",
        "location",
        "violates",
        "corrected_text"
      ],
      "properties": {
        "entity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "attribute": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "aliases": {
          "type": "array",
          "maxItems": 5,
          "description": "Other (entity, attribute) keys that name the same figure.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity",
              "attribute"
            ],
            "properties": {
              "entity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "attribute": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": "Words that name the figure in text."
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "description": "Units a stated value would carry."
        },
        "needed_by": {
          "type": "string",
          "pattern": "^REQ-[0-9]{3,}(/AC-[0-9]{3,})?$"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "violates": {
          "$ref": "#/$defs/violates"
        },
        "corrected_text": {
          "$ref": "#/$defs/corrected_text"
        }
      }
    },
    "spec_counts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Set by the validity check: the spec's entries per key, the denominators of the metrics.",
      "required": [
        "quality_drivers",
        "conflicts",
        "defects",
        "interface_needs",
        "unknown_figures"
      ],
      "properties": {
        "quality_drivers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "defects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "interface_needs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "unknown_figures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    }
  }
}
