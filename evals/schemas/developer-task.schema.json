{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Diet-Companion/staff/evals/schemas/developer-task.schema.json",
  "title": "Developer eval task (S-DEV-036)",
  "description": "One golden, hidden or promotion task for the Developer. The seeding agent writes it (S-GEN-067); the eval runner reads it. overlay is what the agent sees on top of the pinned product commit. reference and heldout are never shown to the agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "agent",
    "set",
    "kind",
    "base_sha",
    "ticket",
    "overlay",
    "reference",
    "heldout"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]{12}$",
      "description": "Opaque; carries no hint of kind or content."
    },
    "agent": {
      "const": "developer"
    },
    "set": {
      "enum": [
        "visible",
        "hidden",
        "promotion"
      ]
    },
    "kind": {
      "enum": [
        "feature",
        "fix",
        "trap"
      ]
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The pinned product commit (S-GEN-043)."
    },
    "seeding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "maxLength": 40
        },
        "staff_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "holdout_seed": {
          "type": "boolean",
          "description": "Fix and trap tasks of a promotion set use holdout seeds only (S-GEN-038)."
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 600,
      "description": "The seeding agent's note on what the task tests. Private."
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "title",
        "body"
      ],
      "properties": {
        "label": {
          "enum": [
            "dev:implement",
            "dev:fix"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "overlay": {
      "$ref": "#/$defs/files",
      "description": "Written onto the product before the agent runs: new or changed requirements and architecture, and for a fix task the seeded bug."
    },
    "reference": {
      "$ref": "#/$defs/files",
      "description": "Written onto base + overlay: the reference implementation (feature) or the correction (fix). Empty for a trap."
    },
    "heldout": {
      "type": "array",
      "maxItems": 6,
      "description": "API-layer test files placed in tests/api/heldout/ at scoring time: the acceptance tests (feature) or the symptom check (fix). Empty for a trap.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "content"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,60}\\.api\\.test\\.ts$"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60000
          }
        }
      }
    },
    "heldout_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200,
      "description": "Held-out tests that pass on the reference, set by the validity check. The denominator of the AC pass rate."
    },
    "trap": {
      "type": "array",
      "maxItems": 4,
      "description": "The planted defects (S-DEV-036): keyed (AC ID, defect kind) or (AC ID, need).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}(/AC-[0-9]{3,})?$"
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ambiguous",
                "contradicts",
                "untestable",
                "missing",
                "infeasible"
              ]
            }
          },
          "needs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "interface",
                "element",
                "dependency",
                "data",
                "technology",
                "testability"
              ]
            }
          }
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "affected",
        "symptom"
      ],
      "description": "The catalogue entry of a fix task's seeded bug (S-GEN-039).",
      "properties": {
        "category": {
          "enum": [
            "boundary",
            "missing_check",
            "wrong_value",
            "wrong_branch",
            "state",
            "error_mapping"
          ]
        },
        "affected": {
          "type": "string",
          "pattern": "^(REQ-[0-9]{3,}/AC-[0-9]{3,}|R-[0-9]{3,}|ADR-[0-9]{3,}/[A-Za-z0-9-]+)$"
        },
        "symptom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  },
  "$defs": {
    "files": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9._/-]{1,200}$"
          },
          "content": {
            "type": "string",
            "maxLength": 200000
          }
        }
      }
    }
  }
}
