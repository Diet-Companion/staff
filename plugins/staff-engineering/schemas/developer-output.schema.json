{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:staff:staff-engineering:developer-output:1.0.0",
  "title": "Developer read-stage output",
  "description": "Structured output of the Developer read stage, read-only form (S-DEV-021, S-SEC-002, S-SEC-003). The model proposes proposed_files[]; the harness applies it in the work sandbox (S-DEV-042), derives files[] from the workspace diff, and the write stage acts only on the validated result. Free-text fields and content chunks are at most 2,000 characters (S-SEC-002).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent",
    "decision_summary",
    "pr",
    "proposed_files",
    "classification",
    "defect_items",
    "design_requests",
    "questions",
    "assumptions",
    "private_reports",
    "code_map",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "agent": {
      "const": "developer"
    },
    "decision_summary": {
      "description": "Required. What the human must decide first, then the S-DEV-024 items, then prose (S-DEV-024).",
      "$ref": "#/$defs/text"
    },
    "pr": {
      "description": "The product-PR block (S-DEV-009), or null when no code is proposed.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/pr"
        }
      ]
    },
    "proposed_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposed_file"
      },
      "maxItems": 25,
      "description": "The proposed change (read-only form of S-DEV-021 files[]). Non-empty exactly when pr is set."
    },
    "classification": {
      "description": "Set on every dev:fix ticket (S-DEV-017), else null.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/classification"
        }
      ]
    },
    "defect_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/defect_item"
      },
      "maxItems": 7
    },
    "design_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/design_request"
      },
      "maxItems": 7
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "maxItems": 7,
      "description": "At most 7, blocking first (S-BA-014)."
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run_assumption"
      }
    },
    "private_reports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/private_report"
      },
      "maxItems": 7
    },
    "code_map": {
      "description": "dev:bootstrap only, else null.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/code_map"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "description": "Every source the run read and cites."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pr": {
            "type": "object"
          }
        },
        "required": [
          "pr"
        ]
      },
      "then": {
        "properties": {
          "proposed_files": {
            "minItems": 1
          },
          "pr": {
            "properties": {
              "kind": {
                "enum": [
                  "feature",
                  "fix",
                  "drift",
                  "refactor"
                ]
              },
              "ticket": {
                "type": "string"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "proposed_files": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pr": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "fix"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "pr"
        ]
      },
      "then": {
        "properties": {
          "classification": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "code_defect"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "requirement_defect",
                  "not_a_code_defect"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "pr": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "requirement_defect"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "defect_items": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code_map": {
            "type": "object"
          }
        },
        "required": [
          "code_map"
        ]
      },
      "then": {
        "properties": {
          "pr": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "ref": {
      "description": "A source ref: ticket, comment, CI or check result, REQ/AC/TC ID, R-ID, IF version or element, ADR-n/C-k, test ID, or repo path (with line).",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "path": {
      "description": "A repo-relative, normalised file path: no leading slash, no . or .. segment, no backslash or control character, not under .git/.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!\\.git/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\x00-\\x1f\\\\]+$"
    },
    "chunk": {
      "description": "One ordered chunk of a file's full content, at most 2,000 characters (S-DEV-021). No NUL: binary content is never passed.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\x00]*$"
    },
    "req_id": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^REQ-[0-9]{3,}$"
    },
    "ac_id": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^REQ-[0-9]{3,}/AC-[0-9]{3,}$"
    },
    "any_req_id": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^REQ-[0-9]{3,}(/AC-[0-9]{3,})?$"
    },
    "rule_id": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^R-[0-9]{3,}$"
    },
    "if_version": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^IF-[0-9]{3,}@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "if_element": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^IF-[0-9]{3,}@[0-9]+\\.[0-9]+\\.[0-9]+#[^\\s#]{1,200}$"
    },
    "adr_constraint": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^ADR-[0-9]{3,}/C-[0-9]{3,}$"
    },
    "fix_target": {
      "description": "A dev:fix or drift target: a ready AC, an active rule, an element of an approved or deprecated version, or an ADR-n/C-k of an accepted ADR (S-DEV-007, S-DEV-009).",
      "anyOf": [
        {
          "$ref": "#/$defs/ac_id"
        },
        {
          "$ref": "#/$defs/rule_id"
        },
        {
          "$ref": "#/$defs/if_element"
        },
        {
          "$ref": "#/$defs/adr_constraint"
        }
      ]
    },
    "test_id": {
      "description": "Test ID v1, <path>::<name> as the area's test_list command prints it (S-DEV-045).",
      "type": "string",
      "minLength": 4,
      "maxLength": 500,
      "pattern": "^[^\\s:][^\\x00-\\x1f]*::[^\\x00-\\x1f]+$"
    },
    "proposed_file": {
      "description": "One file of the proposed change (read-only form of S-DEV-021 files[]). content is the file's full new content as ordered chunks, never a diff or a reference. The harness applies it in the work sandbox and derives files[] from the workspace diff (S-DEV-042).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "op",
        "content"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "op": {
          "enum": [
            "add",
            "modify",
            "delete",
            "rename"
          ]
        },
        "from": {
          "description": "rename only: the old path.",
          "$ref": "#/$defs/path"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chunk"
          },
          "maxItems": 50,
          "description": "Ordered chunks; concatenated, they are the file byte for byte. Empty for delete (and for an empty file)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "rename"
              }
            }
          },
          "then": {
            "required": [
              "from"
            ]
          },
          "else": {
            "not": {
              "required": [
                "from"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "delete"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "from",
        "to",
        "reason"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/short_text"
        },
        "from": {
          "description": "null for an addition.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/short_text"
            }
          ]
        },
        "to": {
          "description": "null for a removal.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/short_text"
            }
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flag_id",
        "reason"
      ],
      "properties": {
        "flag_id": {
          "description": "The flag the code diff check is expected to raise, as (check, element) (S-DEV-028). The check prints the final ID.",
          "$ref": "#/$defs/short_text"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "pr": {
      "description": "The product-PR block (S-DEV-009). At stage 1 it heads the draft comment; at stage 2 the PR body.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ticket",
        "implements_acs",
        "implements",
        "fixes",
        "constraints",
        "untested_acs",
        "not_unit_observable",
        "characterization",
        "dependencies",
        "flags"
      ],
      "properties": {
        "kind": {
          "enum": [
            "feature",
            "fix",
            "drift",
            "refactor",
            "upkeep"
          ]
        },
        "ticket": {
          "description": "The ticket this change covers. One ticket, one area per PR (S-DEV-010).",
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "implements_acs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ac",
              "part"
            ],
            "properties": {
              "ac": {
                "$ref": "#/$defs/ac_id"
              },
              "part": {
                "enum": [
                  "full",
                  "partial"
                ]
              }
            }
          },
          "maxItems": 20,
          "description": "Required for feature. full only when every part of the AC is built (S-DEV-044)."
        },
        "implements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/if_version"
          },
          "maxItems": 10,
          "description": "IF-n@x.y.z versions implemented (S-ARCH-021)."
        },
        "fixes": {
          "description": "For fix and drift only (S-DEV-009).",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ticket",
                "target"
              ],
              "properties": {
                "ticket": {
                  "$ref": "#/$defs/ref"
                },
                "target": {
                  "$ref": "#/$defs/fix_target"
                }
              }
            }
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "disposition",
              "reason"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/adr_constraint"
              },
              "disposition": {
                "enum": [
                  "conform",
                  "n/a"
                ]
              },
              "reason": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "maxItems": 50,
          "description": "Every check: review constraint of the accepted ADRs the touched components cite (S-ARCH-026)."
        },
        "untested_acs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ac",
              "reason"
            ],
            "properties": {
              "ac": {
                "$ref": "#/$defs/ac_id"
              },
              "reason": {
                "enum": [
                  "other-layer",
                  "not-unit-observable"
                ]
              }
            }
          },
          "maxItems": 20
        },
        "not_unit_observable": {
          "description": "fix only: a defect no unit test can observe, with the test gap for QA. A flagged diff (S-DEV-010, S-DEV-018).",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "test_gap"
              ],
              "properties": {
                "target": {
                  "$ref": "#/$defs/fix_target"
                },
                "test_gap": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          ]
        },
        "characterization": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test_id"
          },
          "maxItems": 50,
          "description": "Characterization tests added (S-DEV-015)."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "maxItems": 20,
          "description": "Every dependency_files change; each is flagged and labelled dev:dependency (S-DEV-018, S-SEC-009)."
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          },
          "maxItems": 50,
          "description": "Every diff the code diff check is expected to flag, with the reason (S-DEV-018)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "feature"
              }
            }
          },
          "then": {
            "properties": {
              "implements_acs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "fix",
                  "drift"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "fixes": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "fixes": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fix"
              }
            }
          },
          "then": {},
          "else": {
            "properties": {
              "not_unit_observable": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "refactor",
                  "upkeep"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "implements_acs": {
                "maxItems": 0
              },
              "untested_acs": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "question_id": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^Q-[0-9]{3,}$"
    },
    "assumption_id": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^A-[0-9]{3,}$"
    },
    "key": {
      "description": "What a question or assumption is about (S-BA-007 key form).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "target_id",
        "attribute"
      ],
      "properties": {
        "entity": {
          "$ref": "#/$defs/short_text"
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "attribute": {
          "$ref": "#/$defs/short_text"
        }
      }
    },
    "question": {
      "description": "An implementation trade-off no rule, AC or ADR decides, in the S-BA-014 form (S-DEV-008).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "blocks",
        "blocking",
        "text",
        "options",
        "recommended",
        "priority"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/question_id"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 1,
          "description": "The AC IDs, IF elements, ADR constraints or ticket it blocks."
        },
        "blocking": {
          "type": "boolean"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 1,
                "pattern": "^[a-d]$"
              },
              "text": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "minItems": 2,
          "maxItems": 4
        },
        "recommended": {
          "description": "Shown to the human; never applied without an operator answer.",
          "type": "string",
          "maxLength": 1,
          "pattern": "^[a-d]$"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      }
    },
    "run_assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "text",
        "blocking"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/assumption_id"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "defect_item": {
      "description": "A requirement-defect item in the S-BA-048 form, posted on the requirement's ticket (S-DEV-008). text explains it for the human.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "kind",
        "evidence_refs",
        "text"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/any_req_id"
        },
        "kind": {
          "enum": [
            "ambiguous",
            "contradicts",
            "untestable",
            "missing",
            "infeasible"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 1
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "design_request": {
      "description": "A design request comment (S-DEV-008), which the human may turn into arch:design.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "need",
        "missing",
        "evidence_refs"
      ],
      "properties": {
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ac_id"
            },
            {
              "$ref": "#/$defs/if_element"
            },
            {
              "$ref": "#/$defs/adr_constraint"
            }
          ]
        },
        "need": {
          "enum": [
            "interface",
            "element",
            "dependency",
            "data",
            "technology",
            "testability"
          ]
        },
        "missing": {
          "$ref": "#/$defs/text"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 1
        }
      }
    },
    "private_report": {
      "description": "A suspected vulnerability or exposed secret (S-DEV-019, S-SEC-011). Filed privately; never quotes a secret's value.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "location",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^SR-[0-9]{3,}$"
        },
        "kind": {
          "enum": [
            "vulnerability",
            "exposed_secret"
          ]
        },
        "location": {
          "description": "Where it is (path and line, or comment ref), never the value.",
          "$ref": "#/$defs/ref"
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "classification": {
      "description": "The dev:fix classification (S-DEV-017).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "defect",
        "drafted",
        "cites",
        "note"
      ],
      "properties": {
        "kind": {
          "enum": [
            "code_defect",
            "requirement_defect",
            "not_a_code_defect"
          ]
        },
        "defect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "expected",
            "actual",
            "evidence_refs"
          ],
          "properties": {
            "target": {
              "$ref": "#/$defs/fix_target"
            },
            "expected": {
              "$ref": "#/$defs/text"
            },
            "actual": {
              "$ref": "#/$defs/text"
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ref"
              },
              "minItems": 1
            }
          }
        },
        "drafted": {
          "type": "array",
          "items": {
            "enum": [
              "target",
              "expected",
              "actual",
              "evidence_refs"
            ]
          },
          "maxItems": 4,
          "uniqueItems": true,
          "description": "Fields the Developer drafted because the report lacked them."
        },
        "cites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 1,
          "description": "The cited source and the code it was compared with."
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "regex": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "stack": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9+_.-]{0,63}$"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "code_map": {
      "description": "dev:bootstrap only: a draft .staff/code.yml entry for one area (S-DEV-004, S-DEV-006), with each pattern's match count and sample lines. The human commits it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "entry",
        "evidence"
      ],
      "properties": {
        "area": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "unit_tests",
            "generated",
            "protected",
            "dependency_files",
            "verification_config",
            "guard_patterns",
            "test_list",
            "generators",
            "interface_source",
            "upkeep_tools"
          ],
          "properties": {
            "source": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/glob"
              },
              "maxItems": 50
            },
            "unit_tests": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/glob"
              },
              "maxItems": 50
            },
            "generated": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/glob"
              },
              "maxItems": 50
            },
            "protected": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/glob"
              },
              "maxItems": 50
            },
            "dependency_files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/glob"
              },
              "maxItems": 50
            },
            "verification_config": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/glob"
              },
              "maxItems": 50
            },
            "guard_patterns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stack",
                  "test_decl",
                  "assertion",
                  "skip",
                  "expected_failure",
                  "authorization",
                  "validation",
                  "permission_deny",
                  "lint_suppression",
                  "testability"
                ],
                "properties": {
                  "stack": {
                    "$ref": "#/$defs/stack"
                  },
                  "test_decl": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/regex"
                    },
                    "maxItems": 20
                  },
                  "assertion": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/regex"
                    },
                    "maxItems": 20
                  },
                  "skip": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/regex"
                    },
                    "maxItems": 20
                  },
                  "expected_failure": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/regex"
                    },
                    "maxItems": 20
                  },
                  "authorization": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/regex"
                    },
                    "maxItems": 20
                  },
                  "validation": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/regex"
                    },
                    "maxItems": 20
                  },
                  "permission_deny": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/regex"
                    },
                    "maxItems": 20
                  },
                  "lint_suppression": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/regex"
                    },
                    "maxItems": 20
                  },
                  "testability": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/regex"
                    },
                    "maxItems": 20
                  }
                }
              },
              "maxItems": 10
            },
            "test_list": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stack",
                  "command"
                ],
                "properties": {
                  "stack": {
                    "$ref": "#/$defs/stack"
                  },
                  "command": {
                    "$ref": "#/$defs/command"
                  }
                }
              },
              "maxItems": 10
            },
            "generators": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "generator_id",
                  "version",
                  "command",
                  "inputs",
                  "outputs"
                ],
                "properties": {
                  "generator_id": {
                    "$ref": "#/$defs/short_text"
                  },
                  "version": {
                    "$ref": "#/$defs/short_text"
                  },
                  "command": {
                    "$ref": "#/$defs/command"
                  },
                  "inputs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/glob"
                    },
                    "minItems": 1,
                    "maxItems": 50
                  },
                  "outputs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/glob"
                    },
                    "minItems": 1,
                    "maxItems": 50
                  }
                }
              },
              "maxItems": 20
            },
            "interface_source": {
              "description": "A command, or none (S-DEV-012).",
              "anyOf": [
                {
                  "const": "none"
                },
                {
                  "$ref": "#/$defs/command"
                }
              ]
            },
            "upkeep_tools": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tool_id",
                  "kind",
                  "version",
                  "command"
                ],
                "properties": {
                  "tool_id": {
                    "$ref": "#/$defs/short_text"
                  },
                  "kind": {
                    "enum": [
                      "formatter",
                      "linter_autofix",
                      "codemod"
                    ]
                  },
                  "version": {
                    "$ref": "#/$defs/short_text"
                  },
                  "command": {
                    "$ref": "#/$defs/command"
                  }
                }
              },
              "maxItems": 20
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stack",
              "pattern_class",
              "pattern",
              "match_count",
              "samples"
            ],
            "properties": {
              "stack": {
                "$ref": "#/$defs/stack"
              },
              "pattern_class": {
                "enum": [
                  "test_decl",
                  "assertion",
                  "skip",
                  "expected_failure",
                  "authorization",
                  "validation",
                  "permission_deny",
                  "lint_suppression",
                  "testability"
                ]
              },
              "pattern": {
                "$ref": "#/$defs/regex"
              },
              "match_count": {
                "type": "integer",
                "minimum": 0
              },
              "samples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "line",
                    "text"
                  ],
                  "properties": {
                    "path": {
                      "$ref": "#/$defs/path"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 500
                    }
                  }
                },
                "maxItems": 3
              }
            }
          },
          "maxItems": 200
        }
      }
    }
  }
}
