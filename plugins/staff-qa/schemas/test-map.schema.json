{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://staff.local/schemas/staff-qa/test-map.schema.json",
  "title": ".staff/tests.yml, the QA test map (S-QA-005)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "areas"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "areas": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "unit",
            "api",
            "ui"
          ]
        },
        "additionalProperties": {
          "$ref": "#/$defs/layer"
        }
      }
    }
  },
  "$defs": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)[^\\x00-\\x1f\\\\]+$"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^\\x00-\\x1f]+$"
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "stack",
        "sandbox"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glob"
          },
          "minItems": 1
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glob"
          }
        },
        "mocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glob"
          }
        },
        "request_docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glob"
          }
        },
        "stack": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,40}$",
          "description": "A key into .staff/code.yml guard_patterns and test_list."
        },
        "expected_value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "matcher_strength": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "locators": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 300
              }
            },
            "banned": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        },
        "mutation": {
          "anyOf": [
            {
              "const": "none"
            },
            {
              "type": "object"
            }
          ]
        },
        "fuzz": {
          "anyOf": [
            {
              "const": "none"
            },
            {
              "type": "string",
              "maxLength": 300
            }
          ]
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "setup",
            "build",
            "test",
            "report"
          ],
          "description": "Harness extension: what the stage-1 work sandbox runs for this layer.",
          "properties": {
            "setup": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/command"
              }
            },
            "build": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/command"
              }
            },
            "test": {
              "$ref": "#/$defs/command"
            },
            "report": {
              "$ref": "#/$defs/glob"
            }
          }
        }
      }
    }
  }
}
